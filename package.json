{
  "name": "ghost-tabs-chrome-extension",
  "version": "0.0.1",
  "author": "Mark Miro <contact@markmiro.com> (https://markmiro.com)",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project ./tsconfig-build.json --noEmit && tsc --project ./tsconfig-watch.json --noEmit && tsc --project ./tsconfig.test.json --noEmit",
    "prettier": "prettier --write .",
    "build": "rimraf build && concurrently --kill-others-on-fail --names COPY,TSC \"node scripts-build.mjs\" \"tsc --project ./tsconfig-build.json\"",
    "watch": "concurrently --kill-others --names COPY,TSC \"node scripts-watch.mjs\" \"tsc --watch --project ./tsconfig-watch.json\"",
    "build:clean": "rimraf build",
    "watch:clean": "rimraf build-watch"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "chokidar": "5.0.0",
    "concurrently": "10.0.6",
    "cpy": "13.2.3",
    "prettier": "3.9.10",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "keywords": [
    "chrome",
    "chrome extension",
    "tab",
    "tabs",
    "unread",
    "mark unread",
    "expiration",
    "expire",
    "sour",
    "spoiled",
    "fresh",
    "freshness",
    "inactive",
    "stale",
    "stale markers",
    "hibernate",
    "suspend",
    "fade",
    "fade out",
    "favicon",
    "sleep",
    "doze",
    "rest",
    "snooze",
    "catnap",
    "slumber",
    "nap",
    "ghost",
    "discard",
    "bin"
  ]
}
