{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "rootDir": "./src",
    "types": ["chrome"],
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": false,
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "noImplicitThis": true,
    "noFallthroughCasesInSwitch": true,
    "noEmitOnError": true,
    "removeComments": true,
    "listEmittedFiles": true,
    "skipLibCheck": true
  },
  "exclude": [
    "src/js/helpers/background-headers.ts",
    "test",
    "vitest.config.mts"
  ]
}
